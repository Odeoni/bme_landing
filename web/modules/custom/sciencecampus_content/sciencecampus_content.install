<?php

/**
 * @file
 * Install / update hooks for the Science Campus Content module.
 *
 * Positions field_titulus and field_location_text in the Eloadas
 * "Előadás beküldése" form right after field_speaker and field_date,
 * so editors don't have to reorder them by hand.
 *
 * The view display is left alone — Drupal auto-adds new fields to it,
 * but the eloadas templates render fields explicitly (not via {{ content }}),
 * so unmanaged extras don't appear on the page.
 */

/**
 * Implements hook_install().
 */
function sciencecampus_content_install() {
  _sciencecampus_content_position_fields();
}

/**
 * Update: re-position the fields if a previous install left them at the bottom.
 */
function sciencecampus_content_update_10001() {
  _sciencecampus_content_position_fields();
}

/**
 * Place the new fields next to the speaker / date fields on the form.
 */
function _sciencecampus_content_position_fields() {
  $form_display = \Drupal::service('entity_display.repository')
    ->getFormDisplay('node', 'eloadas', 'default');
  if (!$form_display) {
    return;
  }

  $form_display
    ->setComponent('field_titulus', [
      'type' => 'string_textfield',
      'weight' => _sciencecampus_content_weight_after($form_display, 'field_speaker', 1),
      'region' => 'content',
      'settings' => ['size' => 60, 'placeholder' => 'pl. Dr., Prof., MTA tag'],
      'third_party_settings' => [],
    ])
    ->setComponent('field_location_text', [
      'type' => 'string_textfield',
      'weight' => _sciencecampus_content_weight_after($form_display, 'field_date', 2),
      'region' => 'content',
      'settings' => ['size' => 60, 'placeholder' => 'pl. Q épület előadó'],
      'third_party_settings' => [],
    ])
    ->save();
}

/**
 * Return a weight that places the new field just below an existing one.
 * Falls back to a sensible offset when the anchor field isn't present.
 */
function _sciencecampus_content_weight_after($display, $anchor_field, $offset) {
  $component = $display->getComponent($anchor_field);
  if ($component && isset($component['weight'])) {
    return ((int) $component['weight']) + $offset;
  }
  return 50 + $offset;
}
