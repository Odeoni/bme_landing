{#
/**
 * @file
 * Landing page — Science Campus homepage.
 *
 * Editable fields:
 *   field_hero_image       → Hero background
 *   field_hero_title       → Hero heading
 *   field_hero_subtitle    → Hero subtitle
 *   body                   → "Mi a Science Campus?" section
 *   field_section_image    → Image next to description
 *   field_section_body_2   → "Mit kapsz diákként" section
 *   field_section_image_2  → Image next to "Mit kapsz diákként"
 *   field_cta_text         → Felvételi pont CTA description
 *
 * Structural (not editable, rarely changes):
 *   Programjaink grid      → auto from Program nodes via view
 *   Section headings       → fixed in template
 *   Button labels          → fixed in template
 */
#}

{% set hero_image_url = content.field_hero_image[0] ? file_url(content.field_hero_image[0]['#item'].entity.uri.value) : base_path ~ directory ~ '/images/hero-landing.jpg' %}

<section class="hero" style="background-image: url('{{ hero_image_url }}');">
  <div class="hero__content">
    <h1 class="hero__title">{{ content.field_hero_title }}</h1>
    <p class="hero__subtitle">
      {{ content.field_hero_subtitle }}
      <span class="felveteli-dot"></span>
    </p>
  </div>
</section>

<section class="section section--white">
  <div class="container">
    <div class="split">
      <div class="split__text">
        <h2>Mi a Science Campus?</h2>
        {{ content.body }}
      </div>
      <div class="split__image">
        {% if content.field_section_image[0] %}
          {{ content.field_section_image }}
        {% else %}
          <img src="{{ base_path ~ directory }}/images/mi-a-sc.jpg" alt="Science Campus" loading="lazy">
        {% endif %}
      </div>
    </div>
  </div>
</section>

<section class="section section--grey">
  <div class="container">
    <h2 class="section__title">Science Campus Programjaink</h2>

    <p class="programs-intro">
      <span class="p-badge" aria-hidden="true"></span>
      <span class="programs-intro__text">{{ programjaink_intro_text }}</span>
    </p>

    <div class="program-grid program-grid--main">
      {{ drupal_view('programjaink', 'block_1') }}
    </div>

    <div class="programs-cta">
      <a href="/science-campus-eloadasok" class="btn btn--primary">Science Campus előadásaink</a>
    </div>
  </div>
</section>

<section class="section section--white">
  <div class="container">
    <h2 class="section__title">További Programjaink</h2>

    <div class="program-grid program-grid--extra">
      {{ drupal_view('programjaink', 'block_1') }}
    </div>
  </div>
</section>

<section class="section section--white">
  <div class="container">
    <div class="split">
      <div class="split__text">
        <h2>Mit kapsz diákként, ha részt veszel a programokon?</h2>
        {{ content.field_section_body_2 }}
      </div>
      <div class="split__image">
        {% if content.field_section_image_2[0] %}
          {{ content.field_section_image_2 }}
        {% else %}
          <img src="{{ base_path ~ directory }}/images/diak.jpg" alt="Diák a laborban" loading="lazy">
        {% endif %}
      </div>
    </div>
  </div>
</section>

<section class="felveteli-section">
  <div class="felveteli-section__inner">
    <div>
      <h2 class="felveteli-section__title">
        {{ felveteli_heading }}
        <span class="felveteli-section__dot"></span>
      </h2>
    </div>
    <div class="felveteli-section__text">
      {{ content.field_cta_text }}
      <a href="/felveteli-pontok" class="btn btn--primary" style="margin-top:1rem;">Felvételi pontok</a>
    </div>
  </div>
</section>

<section class="section section--grey" style="text-align:center;">
  <div class="container">
    <h2>Ha tetszenek programjaink, akkor ajánljuk több éves élményprogramjainkat a képzéseinken.</h2>
    <a href="https://kepzesek.ttk.bme.hu/" class="btn btn--outline" style="margin-top:1.5rem;" target="_blank" rel="noopener">Képzéseink</a>
  </div>
</section>
