<article{{ attributes.addClass('event-row', is_archived ? 'event-row--archived' : '') }}>
  {% if content.field_image|render %}
    <a href="{{ node_url }}" class="event-row__image-link" aria-label="{{ label }}">
      <img src="{{ file_url(content.field_image[0]['#item'].entity.uri.value) }}" alt="{{ label }}" class="event-row__image" loading="lazy">
    </a>
  {% endif %}

  <div class="event-row__content">
    {% if content.field_date|render %}
      <time class="event-row__date">{{ content.field_date }}</time>
    {% endif %}

    <h3 class="event-row__title">
      <a href="{{ node_url }}">{{ label }}</a>
    </h3>

    {% if content.field_speaker|render %}
      <p class="event-row__speaker">{{ content.field_speaker }}</p>
    {% endif %}

    {# Tartalom (body) is intentionally NOT rendered on the teaser card —
       it belongs on the full node page only. Editors may put long jargon
       there without it leaking into the listing. #}

    <div class="event-row__links">
      {% if is_archived %}
        <a href="{{ node_url }}" class="btn btn--primary">Nézd vissza az előadást</a>
      {% else %}
        <a href="{{ node_url }}" class="btn btn--outline">Részletek</a>
        {% if content.field_registration_link[0]['#url'] %}
          <a href="{{ content.field_registration_link[0]['#url'] }}" class="btn btn--primary">Regisztráció</a>
        {% endif %}
      {% endif %}
    </div>
  </div>
</article>
