<article{{ attributes.addClass('program-card') }}>
  {% if content.field_logo|render %}
    <img src="{{ file_url(content.field_logo[0]['#item'].entity.uri.value) }}" alt="{{ label }}" class="program-card__logo" loading="lazy">
  {% endif %}

  <h3 class="program-card__title">
    {% if has_felveteli_pont %}
      <span class="program-card__dot" aria-label="Felvételi pontot adó program"></span>
    {% endif %}
    {% if content.field_link[0]['#url'] %}
      <a href="{{ content.field_link[0]['#url'] }}">{{ label }}</a>
    {% else %}
      {{ label }}
    {% endif %}
  </h3>

  {% if content.body|render %}
    <p class="program-card__description">{{ content.body }}</p>
  {% endif %}
</article>
