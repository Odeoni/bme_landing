{#
/**
 * @file
 * Science Campus előadások subpage.
 *
 * Editable: field_hero_image, field_hero_title, field_hero_subtitle, body
 * Structural: section headings, button labels, views
 */
#}

{% set hero_image_url = content.field_hero_image[0] ? file_url(content.field_hero_image[0]['#item'].entity.uri.value) : base_path ~ directory ~ '/images/hero-eloadasok.jpg' %}

<section class="hero" style="background-image: url('{{ hero_image_url }}');">
  <div class="hero__content">
    <h1 class="hero__title">{{ content.field_hero_title }}</h1>
    <p class="hero__subtitle">{{ content.field_hero_subtitle }}</p>
  </div>
</section>

<section class="section section--white">
  <div class="container">
    <h2>Az előadásokról</h2>
    <div class="description-section" style="margin-top:1.5rem;">
      {{ content.body }}
    </div>
    <div style="text-align:center; margin-top:2rem;">
      <a href="https://luma.com/bme_sc" class="btn btn--outline" target="_blank" rel="noopener">Tovább az eseménynaptárra</a>
    </div>
  </div>
</section>

<section class="section section--grey">
  <div class="container">
    <h2 class="section__title">Aktuális előadásaink</h2>
    <div class="event-list">
      {{ drupal_view('aktualis_eloadasok', 'block_1') }}
    </div>
  </div>
</section>

<section class="section section--white">
  <div class="container">
    <h2 class="section__title">Archívum</h2>
    <div class="event-list">
      {{ drupal_view('archivum', 'block_1') }}
    </div>
  </div>
</section>
