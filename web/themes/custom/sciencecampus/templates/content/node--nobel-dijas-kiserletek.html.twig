{#
/**
 * @file
 * Nobel-díjas kísérletek subpage.
 *
 * Editable: field_hero_image, field_hero_title, field_hero_subtitle, body
 * Structural: topics grid (images in theme), program type cards, section headings
 * Views: meresi_foglalkozasok accordion
 */
#}

{% set hero_image_url = content.field_hero_image[0] ? file_url(content.field_hero_image[0]['#item'].entity.uri.value) : base_path ~ directory ~ '/images/hero-nobel.jpg' %}

<section class="hero" style="background-image: url('{{ hero_image_url }}');">
  <div class="hero__content">
    <h1 class="hero__title">{{ content.field_hero_title }}</h1>
    <p class="hero__subtitle">{{ content.field_hero_subtitle }}</p>
  </div>
</section>

<section class="section section--white">
  <div class="container">
    <h2>A programról</h2>
    <div class="description-section" style="margin-top:1.5rem;">
      {{ content.body }}
    </div>
  </div>
</section>

<section class="section section--grey">
  <div class="container">
    <h2 class="section__title">Az alábbi témákban kísérletezhetsz</h2>
    <div class="topics-grid">
      {{ drupal_view('temak', 'block_1') }}
    </div>
  </div>
</section>

<section class="section section--white">
  <div class="container">
    <h2 class="section__title">Program típusai</h2>
    <div class="two-cards">
      <div class="type-card">
        <img src="{{ base_path ~ directory }}/images/type-heti.jpg" alt="Heti egy mérési alkalom" class="type-card__image" loading="lazy">
        <div class="type-card__content">
          <h3 class="type-card__title">Heti egy mérési alkalom októberben</h3>
          <div class="type-card__body">
            <p>Félévenként több alkalommal szervezett, kisebb csoportban szervezett, 3-4 órás laborfoglalkozások.</p>
            <ul>
              <li>Egy-egy Nobel-díjas tématerületre fókuszálunk</li>
              <li>Egy mérés egy alkalommal</li>
              <li>Önállóan is léphetsz be</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="type-card">
        <img src="{{ base_path ~ directory }}/images/type-ketnapos.jpg" alt="Kétnapos szakkör" class="type-card__image" loading="lazy">
        <div class="type-card__content">
          <h3 class="type-card__title">Kétnapos szakkör az őszi szünetben</h3>
          <div class="type-card__body">
            <p>Évente egy alkalommal szervezett, kétnapos tudományos élményprogram.</p>
            <ul>
              <li>Elméleti bevezető előadás</li>
              <li>Több választható mérési blokk</li>
              <li>Közösségi program</li>
              <li>Élménydús laborlátogatás</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div style="text-align:center; margin-top:2rem;">
      <a href="https://luma.com/bme_sc" class="btn btn--outline" target="_blank" rel="noopener">Aktuális programjaink</a>
    </div>
  </div>
</section>

<section class="section section--grey">
  <div class="container">
    <h2 class="section__title">Mérési foglalkozásaink részletesen:</h2>
    <div class="accordion">
      {{ drupal_view('meresi_foglalkozasok', 'block_1') }}
    </div>
  </div>
</section>
