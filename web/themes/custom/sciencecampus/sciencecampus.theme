<?php

/**
 * @file
 * Theme functions for Science Campus theme.
 */

use Drupal\node\NodeInterface;
use Drupal\file\Entity\File;

/**
 * Implements hook_preprocess_page().
 */
function sciencecampus_preprocess_page(&$variables) {
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof NodeInterface) {
    $variables['node_type'] = $node->bundle();
    $variables['node_id'] = $node->id();
  }

  // Pass theme image URLs to page template.
  $theme_path = \Drupal::theme()->getActiveTheme()->getPath();
  $image_settings = [
    'sc_logo_url' => ['setting' => 'sc_logo', 'fallback' => $theme_path . '/images/sc-logo.png'],
    'bme_logo_url' => ['setting' => 'bme_logo', 'fallback' => $theme_path . '/images/bme-logo.png'],
    'campus_map_url' => ['setting' => 'campus_map', 'fallback' => $theme_path . '/images/campus-map.png'],
  ];

  foreach ($image_settings as $var_name => $config) {
    $fid = theme_get_setting($config['setting']);
    if ($fid) {
      $file = File::load($fid);
      if ($file) {
        $variables[$var_name] = \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri());
        continue;
      }
    }
    $variables[$var_name] = '/' . $config['fallback'];
  }

  // Footer social media URLs. Fall back to the official URLs when the
  // theme setting is empty so icons stay visible on existing installs
  // where the install-time defaults never seeded.
  $social_defaults = [
    'youtube_url'   => 'https://www.youtube.com/@BMETTK_1998',
    'facebook_url'  => 'https://www.facebook.com/BME.TTK.ScienceCampus',
    'instagram_url' => 'https://www.instagram.com/science_campus_bme_ttk/',
  ];
  foreach ($social_defaults as $var_name => $default) {
    $value = theme_get_setting($var_name);
    $variables[$var_name] = !empty($value) ? $value : $default;
  }
}

/**
 * Implements hook_preprocess_node().
 */
function sciencecampus_preprocess_node(&$variables) {
  $node = $variables['node'];
  if ($node->bundle() === 'program' && $node->hasField('field_felveteli_pont')) {
    $variables['has_felveteli_pont'] = (bool) $node->get('field_felveteli_pont')->value;
  }
  if ($node->bundle() === 'eloadas' && $node->hasField('field_archive')) {
    $variables['is_archived'] = (bool) $node->get('field_archive')->value;
    $variables['node_url'] = $node->toUrl()->toString();
  }
  if ($node->bundle() === 'eloadas' && $node->hasField('field_video_url')) {
    $url = $node->get('field_video_url')->uri ?? '';
    $variables['video_embed_url'] = _sciencecampus_video_embed_url($url);
  }
  if ($node->bundle() === 'eloadas') {
    // Editable Helyszín label (defaults to "Térkép a termeinkhez").
    // Always renders as a link to /terkep.
    $location_text = '';
    if ($node->hasField('field_location_text')) {
      $location_text = trim((string) $node->get('field_location_text')->value);
    }
    $variables['location_text'] = $location_text !== '' ? $location_text : 'Térkép a termeinkhez';

    // Inherit hero (image + title + subtitle) from the Science Campus
    // előadások landing node, so every eloadas subpage feels like a sub-page
    // of the lectures section. Editor only has to update one node.
    $parent = _sciencecampus_load_node_by_alias('/science-campus-eloadasok');
    if ($parent) {
      if ($parent->hasField('field_hero_image') && !$parent->get('field_hero_image')->isEmpty()) {
        $file = $parent->get('field_hero_image')->entity;
        if ($file) {
          $variables['parent_hero_image_url'] = \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri());
        }
      }
      if ($parent->hasField('field_hero_title')) {
        $variables['parent_hero_title'] = $parent->get('field_hero_title')->value;
      }
      if ($parent->hasField('field_hero_subtitle')) {
        $variables['parent_hero_subtitle'] = $parent->get('field_hero_subtitle')->value;
      }
    }
  }
  if ($node->bundle() === 'landing_page') {
    $variables['programjaink_intro_text'] = theme_get_setting('programjaink_intro_text')
      ?: 'Vegyél részt a pöttyel ellátott programokon, és szerezz intézményi felvételi pontokat.';
  }
}

/**
 * Load a node by its URL alias (e.g. /science-campus-eloadasok), or NULL.
 */
function _sciencecampus_load_node_by_alias($alias) {
  $path = \Drupal::service('path_alias.manager')->getPathByAlias($alias);
  if (!$path || $path === $alias || !preg_match('#^/node/(\d+)$#', $path, $m)) {
    return NULL;
  }
  return \Drupal\node\Entity\Node::load($m[1]);
}

/**
 * Convert a YouTube or Vimeo watch URL into an embeddable player URL.
 * Returns NULL for unrecognised URLs so the template can skip rendering.
 */
function _sciencecampus_video_embed_url($url) {
  if (empty($url)) {
    return NULL;
  }

  // YouTube: watch?v=, youtu.be/, embed/, live/, shorts/
  if (preg_match('#(?:youtube\.com/(?:watch\?(?:.*&)?v=|embed/|live/|shorts/)|youtu\.be/)([A-Za-z0-9_-]{6,})#', $url, $m)) {
    return 'https://www.youtube.com/embed/' . $m[1];
  }

  // Vimeo: vimeo.com/ID or vimeo.com/video/ID
  if (preg_match('#vimeo\.com/(?:video/)?(\d+)#', $url, $m)) {
    return 'https://player.vimeo.com/video/' . $m[1];
  }

  return NULL;
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function sciencecampus_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof NodeInterface) {
    $suggestions[] = 'page__node__' . $node->bundle();
  }
}

/**
 * Implements hook_form_alter().
 *
 * Add editor-facing guidance on Eloadas image upload to avoid layouts
 * being broken by oversized images.
 */
function sciencecampus_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  if ($form_id === 'node_eloadas_form' || $form_id === 'node_eloadas_edit_form') {
    if (isset($form['field_image']['widget'])) {
      $hint = t('Ajánlott maximális méret: 800×600 pixel. A nagyobb képek a megjelenítéskor le lesznek vágva (max. 600 pixel magas mobilon, 480 pixel asztali nézetben).');
      $form['field_image']['widget']['#description'] = $hint;
      if (isset($form['field_image']['widget'][0])) {
        $form['field_image']['widget'][0]['#description'] = $hint;
      }
    }
  }
}

/**
 * Implements hook_theme_suggestions_node_alter().
 *
 * Add template suggestions based on the URL path alias, so each landing page
 * can have its own template (e.g. node--nobel-dijas-kiserletek.html.twig).
 */
function sciencecampus_theme_suggestions_node_alter(array &$suggestions, array $variables) {
  $node = $variables['elements']['#node'];
  if (!$node instanceof NodeInterface) {
    return;
  }

  // Add suggestion based on path alias.
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $node->id());
  if ($alias && $alias !== '/node/' . $node->id()) {
    // Convert /nobel-dijas-kiserletek to node__nobel_dijas_kiserletek
    $alias_clean = ltrim($alias, '/');
    $alias_clean = str_replace('-', '_', $alias_clean);
    $alias_clean = str_replace('/', '_', $alias_clean);
    $suggestions[] = 'node__' . $alias_clean;
  }
}
